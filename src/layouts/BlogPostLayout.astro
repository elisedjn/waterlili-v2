---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { type Locale } from '@i18n/config';
import { localizedRoutes, withBase } from '@i18n/routes';
import { sharedText, siteName } from '@i18n/ui';

interface Props {
  post: CollectionEntry<'blog'>;
  Content: any;
}

const { post, Content } = Astro.props;
const lang = post.data.lang as Locale;
const canonicalPath = `${localizedRoutes.blog[lang]}${post.data.slug}/`;
const canonicalUrl = new URL(withBase(canonicalPath), Astro.site).toString();
const imageUrl = post.data.image
  ? new URL(withBase(post.data.image), Astro.site).toString()
  : undefined;
const dateLabel = post.data.date.toLocaleDateString(lang, {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const seoAlternates = { [lang]: canonicalPath };
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  inLanguage: lang,
  url: canonicalUrl,
  image: imageUrl,
  keywords: post.data.tags,
  author: {
    '@type': 'Organization',
    name: siteName,
  },
  publisher: {
    '@type': 'Organization',
    name: siteName,
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  routeKey='blog'
  canonicalPath={canonicalPath}
  seoType='article'
  seoAlternates={seoAlternates}
  image={post.data.image}
  jsonLd={articleSchema}
>
  <div class='mx-auto max-w-4xl px-5 pb-6 pt-10'>
    <a
      href={withBase(localizedRoutes.blog[lang])}
      class='text-sm font-black uppercase tracking-[0.18em] text-grey/55 transition hover:text-pink'
    >
      ← {sharedText[lang].latestPosts}
    </a>
  </div>
  {
    post.data.image && (
      <div class='relative'>
        <img
          src={withBase(post.data.image)}
          alt=''
          width='1600'
          height='700'
          decoding='async'
          class='h-72 w-full object-cover md:h-[28rem]'
        />
        <div class='absolute inset-0 bg-grey/70' />
        <header class='absolute inset-0 mx-auto flex max-w-4xl flex-col justify-center px-5 text-white'>
          <p class='text-sm font-bold uppercase tracking-[0.22em]'>
            {dateLabel}
          </p>
          <h1 class='mt-4 font-heading text-6xl leading-[0.9] [text-shadow:0_2px_12px_rgb(0_0_0/0.45)] md:text-8xl'>
            {post.data.title}
          </h1>
        </header>
      </div>
    )
  }
  <article class='mx-auto max-w-4xl px-5 pb-16 pt-10'>
    {
      !post.data.image && (
        <header>
          <p class='text-sm font-bold uppercase tracking-[0.22em] text-blue'>
            {dateLabel}
          </p>
          <h1 class='mt-5 font-heading text-6xl leading-[0.9] text-grey md:text-7xl'>
            {post.data.title}
          </h1>
        </header>
      )
    }
    <div class='prose-blog mt-6 flow-root'>
      <Content />
    </div>
  </article>
</BaseLayout>
