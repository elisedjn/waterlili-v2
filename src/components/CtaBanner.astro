---
import LinkButton from '@components/LinkButton.astro';

interface Props {
  title: string;
  buttonLabel: string;
  href: string;
  color?: 'pink' | 'yellow' | 'green' | 'orange' | 'blue';
}

const { title, buttonLabel, href, color = 'green' } = Astro.props;
const backgrounds = {
  pink: 'bg-pink',
  yellow: 'bg-yellow',
  green: 'bg-green',
  orange: 'bg-orange',
  blue: 'bg-blue',
};
---

<section class='px-5 py-10'>
  <div
    class:list={[
      'mx-auto flex max-w-6xl flex-col items-center gap-5 rounded-[2rem] px-6 py-10 text-center text-white shadow-xl shadow-pink/10 md:flex-row md:justify-between md:px-10 md:text-left',
      backgrounds[color],
    ]}
  >
    <p class='font-heading text-4xl font-bold leading-[0.9] md:text-5xl'>{title}</p>
    <div class='shrink-0'>
      <LinkButton href={href} variant='secondary' color='yellow'>{buttonLabel}</LinkButton>
    </div>
  </div>
</section>
