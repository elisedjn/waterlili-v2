---
import { printFormats, type PrintFormatId } from '@config/print-formats';
import { type Locale } from '@i18n/config';

interface Props {
  formats: PrintFormatId[];
  lang: Locale;
}

const { formats, lang } = Astro.props;
---

<ul class='divide-y divide-pink/15'>
  {
    formats.map((id) => {
      const format = printFormats[id];

      return (
        <li class='flex items-baseline justify-between gap-4 py-2'>
          <span>
            <span class='font-bold'>{format.label[lang]}</span>
            <span class='ml-2 text-sm text-grey/70'>{format.size}</span>
          </span>
          <span class='font-bold text-grey'>{format.price}€</span>
        </li>
      );
    })
  }
</ul>
